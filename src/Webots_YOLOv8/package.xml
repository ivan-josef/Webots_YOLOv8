<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>Webots_YOLOv8</name>
  <version>0.0.1</version>
  <description>Pacote de detecção de objetos para a EDROM usando YOLOv8, unificado para simulação e robô real.</description>
  <maintainer email="ivanjosef141@gmail.com">IVANj</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>cv_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>vision_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros_py</depend>
  <depend>soccer_vision_2d_msgs</depend>
  


  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>soccer_ipm</exec_depend>
  <exec_depend>ipm_library</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
